# ========================
# 1. 项目构建与库输出目录
# ========================
# CMake 编译生成的中间文件目录
build/
# 编译生成的动态库/静态库输出目录（如 libmymuduo.so）
lib/
# 后续如果新增可执行文件输出目录
bin/

# ========================
# 2. C/C++ 编译产物与调试文件
# ========================
*.o
*.obj
*.a
*.so
*.so.*
*.out
*.exe
# GDB 调试或程序崩溃产生的核心转储文件
core
core.*

# ========================
# 3. 编辑器与 IDE 本地配置
# ========================
# VS Code 本地路径与插件配置
.vscode/
# clangd / CMake Tools 自动生成的编译数据库与缓存
compile_commands.json
.cache/

# ========================
# 4. 系统与临时文件
# ========================
*.swp
*.swo
*~
.DS_Store
Thumbs.db